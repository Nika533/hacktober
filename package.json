{
  "name": "hoot-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Hoot: an AI desktop buddy and Hoot Lens, the adaptive reading aid",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @hoot/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint --cache .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:live": "vitest run --config apps/desktop/vitest.live.config.mts",
    "build": "npm run build --workspaces --if-present",
    "e2e:desktop": "npm run e2e -w @hoot/desktop",
    "e2e:extension": "npm run e2e -w @hoot/extension",
    "build:win": "npm run build:win -w @hoot/desktop",
    "eval": "npm run eval -w @hoot/desktop",
    "check:ownership": "node scripts/check-ownership.mjs"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^4.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "21.0.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "5.0.3"
  }
}
