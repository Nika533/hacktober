{
  "name": "@hoot/desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Hoot desktop app (Electron). Main: d1 (ai/, lens/, bridge/: C). Renderers: buddy/capture/note d1, studio/reader d3.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron.mjs electron-vite dev",
    "start": "node scripts/run-electron.mjs electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "e2e": "npm run build:e2e && playwright test --pass-with-no-tests",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "install-electron",
    "eval": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@google/genai": "2.28.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@hoot/bridge": "*",
    "@hoot/core": "*",
    "@hoot/pdf-view": "*",
    "@hoot/ui": "*",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "png-to-ico": "3.0.2",
    "pngjs": "^7.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "^8.3.4",
    "zod": "4.6.5"
  }
}
