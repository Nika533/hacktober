{
  "name": "@hoot/extension",
  "version": "0.1.0",
  "private": true,
  "description": "Hoot Lens MV3 extension for Chrome and Edge (owner: d2)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:e2e": "node scripts/build.mjs --mode e2e",
    "dev": "node scripts/build.mjs --mode e2e --watch",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures": "node scripts/build-fixtures.mjs",
    "serve:fixtures": "node scripts/build-fixtures.mjs && node scripts/serve.ts",
    "e2e": "node scripts/build.mjs --mode e2e && node scripts/build-fixtures.mjs && playwright test",
    "zip": "node scripts/build.mjs && node scripts/zip.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@hoot/bridge": "*",
    "@hoot/core": "*",
    "@hoot/lens-dom": "*",
    "@hoot/pdf-view": "*",
    "@hoot/ui": "*",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
