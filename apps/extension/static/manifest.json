{
  "manifest_version": 3,
  "name": "Hoot Lens",
  "version": "0.1.0",
  "description": "Select text you don't understand: Hoot rewrites it in place, marks the change, and undoes it with one click.",
  "key": "",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["storage", "nativeMessaging", "scripting", "webNavigation", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "action": {
    "default_title": "Hoot Lens"
  },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
