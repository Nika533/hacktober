{
  "manifest_version": 3,
  "name": "Hoot Lens",
  "version": "0.0.0",
  "description": "Select text you don't understand: Hoot makes it clearer in place, marks the change, and lets you undo it.",
  "minimum_chrome_version": "120",
  "incognito": "not_allowed",
  "permissions": ["storage"],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_title": "Hoot Lens"
  }
}
