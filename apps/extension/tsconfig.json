{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "chrome"],
    "paths": {
      "@hoot/lens-dom": ["../../packages/lens-dom/src/index.ts"]
    }
  },
  "include": ["src", "tests", "e2e", "scripts/*.ts", "fixtures/**/*.tsx", "playwright.config.ts"]
}
