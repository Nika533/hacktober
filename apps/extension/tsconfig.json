{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/**/*",
    "test/**/*",
    "e2e/**/*",
    "scripts/*.ts",
    "fixtures/**/*.tsx",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true
  }
}
